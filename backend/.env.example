# ==========================================
# Pappu Backend Environment Variables
# ==========================================

# Database Connection
# PostgreSQL connection string for Supabase database. Include pooler/direct port.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & JWT Configuration
# Base URL of your Supabase project
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# JWKS endpoint for validating ES256 Supabase JWTs without a shared secret
SUPABASE_JWKS_URL=https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json

# Sarvam AI API Configuration (LLM, STT, and TTS)
# API subscription key from Sarvam AI dashboard
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM model and endpoint for intent parsing
SARVAM_MODEL=sarvam-105b
SARVAM_API_URL=https://api.sarvam.ai/v1/chat/completions

# Speech-to-Text (STT) model and endpoint (Saaras v3)
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_API_URL=https://api.sarvam.ai/speech-to-text

# Text-to-Speech (TTS) model, endpoint, and voice speaker (Bulbul v3)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_API_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_DEFAULT_SPEAKER=kavitha

# Integration Test Credentials (Optional, for running backend/test_live_api.py)
TEST_USER_EMAIL=test@pappu.dev
TEST_USER_PASSWORD=your_test_password_here
