# ==========================================
# Pappu Backend Environment Variables
# ==========================================

# Database Connection
# PostgreSQL connection string for Supabase database. Include pooler/direct port.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & JWT Configuration (REQUIRED)
# The backend refuses to start unless at least one of these is set to a real value.
# Base URL of your Supabase project
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# JWKS endpoint for validating ES256 Supabase JWTs without a shared secret.
# Optional if SUPABASE_URL is set (derived as <SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_JWKS_URL=https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json

# Sarvam AI API Configuration (LLM, STT, and TTS)
# API subscription key from Sarvam AI dashboard
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM model and endpoint for intent parsing
SARVAM_MODEL=sarvam-105b
SARVAM_API_URL=https://api.sarvam.ai/v1/chat/completions

# Speech-to-Text (STT) model and endpoint (Saaras v3)
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_API_URL=https://api.sarvam.ai/speech-to-text

# Text-to-Speech (TTS) model, endpoint, and voice speaker (Bulbul v3)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_API_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_DEFAULT_SPEAKER=kavitha

# Optional: per-user calls per minute on costly routes (defaults shown), and trace retention.
# RATE_LIMITS_ENABLED=true
# RATE_LIMIT_ASSISTANT_PER_MIN=30
# RATE_LIMIT_STT_PER_MIN=30
# RATE_LIMIT_TTS_PER_MIN=60
# RATE_LIMIT_BILL_READ_PER_MIN=6
# RATE_LIMIT_BILL_ASSIGN_PER_MIN=30
# Delete a user's assistant traces older than this many days (0 keeps them forever).
# TRACE_RETENTION_DAYS=0
