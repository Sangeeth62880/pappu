# ==========================================
# Pappu Frontend Environment Variables
# ==========================================

# Backend API Base URL
# In preview and production, provide the full HTTPS URL without trailing slash (e.g. https://pappu-backend.onrender.com).
# In development (__DEV__), this can be omitted to enable automatic local host discovery via Metro / hostUri.
EXPO_PUBLIC_API_URL=https://your-backend-api.example.com

# Supabase Auth Configuration
# Public project URL and anonymous client key from your Supabase Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Feature Flags
# Set to 'true' to use React Native fetch for voice audio recordings
EXPO_PUBLIC_USE_RN_FETCH=true

# Set to 'true' to enable Assistant V2 features and flow
EXPO_PUBLIC_ASSISTANT_V2=true
